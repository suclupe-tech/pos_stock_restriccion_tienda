<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_users_form_inherit_tienda_restriccion" model="ir.ui.view">
        <field name="name">res.users.form.tienda.restriccion</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Restricción Tienda">

                    <group string="Estado de configuración">
                        <field name="restriccion_config_nivel" invisible="1"/>
                        <field name="restriccion_config_estado"
                            widget="badge"
                            readonly="1"
                            decoration-success="restriccion_config_nivel == 'ok'"
                            decoration-warning="restriccion_config_nivel == 'incompleto'"
                            decoration-muted="restriccion_config_nivel == 'sin_config'"/>
                    </group>

                    <group string="Configuración principal">
                        <field name="warehouse_id" options="{'no_create': True}"/>
                        <field name="pos_config_id" options="{'no_create': True}"/>
                    </group>

                    <group string="Accesos permitidos">
                        <field name="allowed_warehouse_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="allowed_pos_config_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>