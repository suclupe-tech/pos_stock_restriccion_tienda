<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         HISTORIAL DE TRANSFERENCIAS ANTERIORES

         Muestra los traslados internos creados con el flujo antiguo
         de stock.picking.

         No muestra los movimientos técnicos generados por TRF/DEV.

         Esta pantalla es únicamente de consulta:
         - no permite crear;
         - no permite editar;
         - no permite eliminar;
         - no muestra botones operativos de validación.
         ============================================================ -->


    <!-- ============================================================
         VISTA LISTA - SOLO LECTURA
         ============================================================ -->
    <record id="view_picking_legacy_history_list"
            model="ir.ui.view">

        <field name="name">
            stock.picking.legacy.history.list
        </field>

        <field name="model">stock.picking</field>

        <field name="arch" type="xml">

            <list string="Historial de transferencias anteriores"
                  create="false"
                  edit="false"
                  delete="false">

                <field name="name"
                       string="Referencia"/>

                <field name="scheduled_date"
                       string="Fecha programada"/>

                <field name="date_done"
                       string="Fecha realizada"/>

                <field name="location_id"
                       string="Origen"/>

                <field name="location_dest_id"
                       string="Destino"/>

                <field name="origin"
                       string="Documento origen"/>

                <field name="state"
                       string="Estado"
                       widget="badge"/>

            </list>

        </field>
    </record>


    <!-- ============================================================
         VISTA FORMULARIO - SOLO LECTURA
         ============================================================ -->
    <record id="view_picking_legacy_history_form"
            model="ir.ui.view">

        <field name="name">
            stock.picking.legacy.history.form
        </field>

        <field name="model">stock.picking</field>

        <field name="arch" type="xml">

            <form string="Transferencia anterior"
                  create="false"
                  edit="false"
                  delete="false">

                <sheet>

                    <div class="oe_title">

                        <label for="name"
                               string="Transferencia"/>

                        <h1>
                            <field name="name"
                                   readonly="1"/>
                        </h1>

                    </div>


                    <!-- ==========================================
                         DATOS GENERALES
                         ========================================== -->
                    <group>

                        <group string="Movimiento">

                            <field name="picking_type_id"
                                   string="Tipo de operación"
                                   readonly="1"/>

                            <field name="location_id"
                                   string="Origen"
                                   readonly="1"/>

                            <field name="location_dest_id"
                                   string="Destino"
                                   readonly="1"/>

                            <field name="origin"
                                   string="Documento origen"
                                   readonly="1"/>

                        </group>


                        <group string="Estado">

                            <field name="scheduled_date"
                                   string="Fecha programada"
                                   readonly="1"/>

                            <field name="date_done"
                                   string="Fecha realizada"
                                   readonly="1"/>

                            <field name="state"
                                   string="Estado"
                                   readonly="1"/>

                        </group>

                    </group>


                    <!-- ==========================================
                         PRODUCTOS DEL TRASLADO
                         ========================================== -->
                    <notebook>

                        <page string="Productos">

                            <field name="move_ids"
                                   readonly="1">

                                <list create="false"
                                      edit="false"
                                      delete="false">

                                    <field name="product_id"
                                           string="Producto"/>

                                    <field name="product_uom_qty"
                                           string="Cantidad"/>

                                    <field name="quantity"
                                           string="Cantidad realizada"/>

                                    <field name="product_uom"
                                           string="Unidad"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ============================================================
         ACCIÓN DEL HISTORIAL

         Solo muestra:
         - traslados internos;
         - movimientos NO técnicos.

         Por eso los movimientos creados automáticamente por TRF/DEV
         no aparecen aquí.
         ============================================================ -->
        <!-- ============================================================
         ACCIÓN DEL HISTORIAL DE TRANSFERENCIAS ANTERIORES
         ============================================================ -->
    <record id="action_picking_legacy_history"
            model="ir.actions.act_window">

        <field name="name">Historial anterior</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">form</field>

        <field name="domain">
            [
                ('picking_type_id.code', '=', 'internal'),
                ('is_store_transfer_technical', '=', False)
            ]
        </field>

        <field name="context">{'create': False}</field>

    </record>


    <!-- ============================================================
         ASIGNAR NUESTRAS VISTAS DE SOLO LECTURA A LA ACCIÓN
         ============================================================ -->

    <record id="action_picking_legacy_history_list"
            model="ir.actions.act_window.view">

        <field name="sequence" eval="1"/>

        <field name="view_mode">list</field>

        <field name="view_id" ref="view_picking_legacy_history_list"/>

        <field name="act_window_id" ref="action_picking_legacy_history"/>

    </record>


    <record id="action_picking_legacy_history_form"
            model="ir.actions.act_window.view">

        <field name="sequence" eval="2"/>

        <field name="view_mode">form</field>

        <field name="view_id" ref="view_picking_legacy_history_form"/>

        <field name="act_window_id" ref="action_picking_legacy_history"/>

    </record>

    <!-- ============================================================
         ACCIÓN DINÁMICA DEL HISTORIAL

         Ejecuta el método del usuario actual para aplicar el filtro
         correspondiente a sus almacenes permitidos.
         ============================================================ -->
    <record id="action_server_picking_legacy_history"
            model="ir.actions.server">

        <field name="name">Historial anterior</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">action = env.user.action_historial_transferencias_anteriores()</field>

    </record>


    <!-- ============================================================
         MENÚ PARA USUARIOS DE TIENDA

         Se coloca junto al nuevo flujo TRF/DEV.
         ============================================================ -->
    <menuitem id="menu_picking_legacy_history"
              name="Historial anterior"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_server_picking_legacy_history"
              groups="pos_stock_restriccion_tienda.group_tienda_restringida"
              sequence="35"/>

</odoo>
