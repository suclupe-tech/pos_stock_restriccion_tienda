<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_productos_mi_tienda_server" model="ir.actions.server">
        <field name="name">Productos de mi tienda</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">action = env.user.action_productos_mi_tienda()</field>
    </record>

    <menuitem id="menu_productos_mi_tienda"
                name="Productos de mi tienda"
                parent="stock.menu_stock_inventory_control"
                action="action_productos_mi_tienda_server"
                sequence="5"
                groups="pos_stock_restriccion_tienda.group_tienda_restringida"/>

    <record id="action_revision_stock_tiendas_server" model="ir.actions.server">
        <field name="name">Revisión de stock de tiendas</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">action = env.user.action_revision_stock_tiendas()</field>
    </record>

    <menuitem id="menu_revision_stock_tiendas"
                name="Revisión de stock de tiendas"
                parent="stock.menu_stock_inventory_control"
                action="action_revision_stock_tiendas_server"
                sequence="6"
                groups="pos_stock_restriccion_tienda.group_supervisor_tiendas"/>

</odoo>