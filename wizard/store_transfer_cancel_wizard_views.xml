<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- ============================================================
         ASISTENTE DE ANULACIÓN

         Este mismo asistente sirve para:
         - Transferencias TRF/xxxxx
         - Devoluciones DEV/xxxxx

         Solo mostrará el documento que corresponda.
         El movimiento de stock se procesa desde Python.
         ============================================================ -->

    <record id="view_store_transfer_cancel_wizard_form"
            model="ir.ui.view">

        <field name="name">dt.store.transfer.cancel.wizard.form</field>
        <field name="model">dt.store.transfer.cancel.wizard</field>

        <field name="arch" type="xml">

            <form string="Anular documento">

                <group>

                    <!-- ==================================================
                         TRANSFERENCIA TRF

                         Solo se muestra cuando el asistente fue abierto
                         desde una transferencia TRF.
                         ================================================== -->
                    <field name="transfer_id"
                           invisible="not transfer_id"/>

                    <!-- ==================================================
                         DEVOLUCIÓN DEV

                         Solo se muestra cuando el asistente fue abierto
                         desde una devolución DEV.
                         ================================================== -->
                    <field name="return_id"
                           invisible="not return_id"/>

                    <!-- Motivo obligatorio para conservar trazabilidad -->
                    <field name="reason"
                           placeholder="Indique el motivo de la anulación..."/>

                </group>

                <footer>

                    <!-- Ejecuta la anulación del TRF o DEV correspondiente -->
                    <button name="action_confirm_cancel"
                            string="Confirmar anulación"
                            type="object"
                            class="btn-danger"/>

                    <!-- Cierra sin realizar ningún cambio -->
                    <button string="Cancelar"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>