<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_stock_restriccion_tienda.OpeningControlPopup" t-inherit="point_of_sale.OpeningControlPopup" t-inherit-mode="extension">
        
        <!-- Reemplazar solo la caja de entrada para cajeros -->
        <xpath expr="//Input" position="replace">
            <t t-if="pos.user.role === 'manager'">
                <Input tModel="[state, 'openingCash']"
                    isValid.bind="env.utils.isValidFloat"
                    callback.bind="handleInputChange"
                    autofocus="true"
                    placeholder.translate="Opening Balance Eg: 123"/>
            </t>
            <t t-else="">
                <input type="text" 
                       class="form-control form-control-lg bg-light text-muted" 
                       t-att-value="state.openingCash" 
                       readonly="readonly" 
                       disabled="disabled" 
                       style="cursor: not-allowed;" />
            </t>
        </xpath>

        <!-- Ocultar botón del desglose de billetes para cajeros -->
        <xpath expr="//div[hasclass('cash-input-sub-section')]/div[hasclass('button')]" position="attributes">
            <attribute name="t-if">pos.user.role === 'manager'</attribute>
        </xpath>

    </t>

</templates>