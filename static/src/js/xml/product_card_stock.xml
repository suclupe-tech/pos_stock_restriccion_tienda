<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pos_stock_restriccion_tienda.ProductCardStock"
       t-inherit="point_of_sale.ProductCard"
       t-inherit-mode="extension">

        <xpath expr="//article" position="inside">
            <t t-if="props.product.qty_available !== undefined">
                <span t-attf-class="position-absolute bottom-0 start-0 badge #{props.product.qty_available &gt; 0 ? 'bg-success' : 'bg-danger'} m-1">
                    Stock: <t t-esc="props.product.qty_available"/>
                </span>
            </t>
        </xpath>

    </t>

</templates>