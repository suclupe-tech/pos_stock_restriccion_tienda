<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================
         SECUENCIA DE TRANSFERENCIAS ENTRE TIENDAS
         Genera automáticamente:
         TRF/000001, TRF/000002, TRF/000003...
         ============================================================ -->
    <record id="seq_dt_store_transfer" model="ir.sequence">
        <field name="name">Transferencias entre Tiendas</field>
